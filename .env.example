# =============================================================
# PostHog 私有化部署配置 — 复制为 .env 后修改
#   cp .env.example .env && vim .env
# =============================================================

# 域名 — 必须配置 DNS A 记录指向本机
DOMAIN=posthog.your-company.com

# 加密密钥 — 必填，用以下命令生成:
#   openssl rand -hex 28
POSTHOG_SECRET=CHANGEME_$(openssl rand -hex 28)

# 字段加密盐 — 必填，用以下命令生成:
#   openssl rand -hex 16
ENCRYPTION_SALT_KEYS=CHANGEME_$(openssl rand -hex 16)

# TLS 配置（可选）
# 留空使用 Let's Encrypt 生产证书
# 测试时可改成 staging:
#   TLS_BLOCK="acme_ca https://acme-staging-v02.api.letsencrypt.org/directory"
TLS_BLOCK=

# 是否禁用上报匿名使用统计（推荐 true 以隔离）
OPT_OUT_CAPTURE=true

# SeaweedFS 容器名（一般无需改）
SEAWEEDFS_DOCKER_NAME=seaweedfs-main

# 数据卷宿主机根目录 — 所有持久化数据存放位置
# 留空或不设置时默认使用 ./data（与 docker-compose.yaml 同级）
# 生产建议指向独立磁盘/挂载点，便于备份与扩容，例如:
#   DATA_ROOT=/mnt/posthog-data
# 首次启动前需提前创建子目录（详见 README "数据卷"）:
#   for d in postgres-data redis7-data clickhouse-data zookeeper-data \
#            zookeeper-datalog zookeeper-logs kafka-data redpanda-data \
#            objectstorage seaweedfs caddy-data caddy-config elasticsearch-data; do
#       mkdir -p "${DATA_ROOT:-./data}/$d"
#   done
DATA_ROOT=./data
