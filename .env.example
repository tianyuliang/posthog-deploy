# =============================================================
# PostHog 私有化部署配置 — 复制为 .env 后修改
#   cp .env.example .env && vim .env
# =============================================================

# ─────────────────────────────────────────────────────────────
# 必填项
# ─────────────────────────────────────────────────────────────

# 域名 — 生产部署必须配置 DNS A 记录指向本机
# 本地试用可填 localhost
DOMAIN=posthog.your-company.com

# 应用密钥 — 必填，用以下命令生成（生成后填到等号右侧）:
#   openssl rand -hex 28
POSTHOG_SECRET=

# 字段加密盐 — 必填，用以下命令生成（生成后填到等号右侧）:
#   openssl rand -hex 16
# 注意：必须正好 32 个 ASCII 字符（hex -16 满足）。PostHog 会做 base64 编码后给 Fernet 用，
# 长度不对会导致 web 启动时 Django 迁移崩溃。
ENCRYPTION_SALT_KEYS=

# ─────────────────────────────────────────────────────────────
# TLS / HTTPS
# ─────────────────────────────────────────────────────────────

# Caddy 全局块 TLS 配置：
#   留空时使用 docker-compose 默认 `auto_https off`，适合本地 / DOMAIN=localhost
#   生产部署留空（默认 Let's Encrypt 生产证书）
#   测试 Let's Encrypt 流程可用 staging 证书:
#     TLS_BLOCK="acme_ca https://acme-staging-v02.api.letsencrypt.org/directory"
TLS_BLOCK=

# ─────────────────────────────────────────────────────────────
# 其他可选项
# ─────────────────────────────────────────────────────────────

# 是否禁用上报匿名使用统计（推荐 true 以隔离）
OPT_OUT_CAPTURE=true

# SeaweedFS 容器名（一般无需改）
SEAWEEDFS_DOCKER_NAME=seaweedfs-main

# ─────────────────────────────────────────────────────────────
# 数据卷
# ─────────────────────────────────────────────────────────────

# 数据卷宿主机根目录 — 所有持久化数据存放位置
# 留空或不设置时默认 ./data（与 docker-compose.yaml 同级）
# 生产 Linux 部署建议指向独立磁盘/挂载点（便于备份与扩容），例如:
#   DATA_ROOT=/mnt/posthog-data
# 首次启动前用以下命令创建所有子目录（含 clickhouse-data / postgres-data 等）:
#   bash scripts/init-volumes.sh
#
# ⚠️ macOS 本地开发警告：ClickHouse 在 macOS Docker Desktop 的 osxfs/VirtioFS
# bind mount 上跑 `CREATE OR REPLACE VIEW` 会触发 atomic rename bug，迁移会失败。
# 如果在 macOS 上本地试用，请使用 docker-compose.override.yaml.example 切换
# clickhouse-data 为 Docker named volume（详见 README "macOS 开发环境"）。
DATA_ROOT=./data
