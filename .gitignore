.env.local
*.env.local

# 本地 docker compose 覆盖（如 macOS 切换 ClickHouse 卷为 named volume）
docker-compose.override.yaml
docker-compose.override.yml

# 运行时数据卷（Postgres / ClickHouse / Kafka 等）
data/

# GeoIP 数据库（运行时下载，体积大，按 README 第 1 步下载）
share/GeoLite2-City.mmdb
share/*.mmdb

